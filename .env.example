# Copy to .env and adjust. `make run` and docker compose load this file.
# The application itself only reads process environment variables.

APP_NAME="Still Alive"
APP_URL=http://localhost:8080
ADDR=:8080
LOG_LEVEL=info

DATABASE_PATH=./stillalive.db

# Set to true when served over HTTPS.
SESSION_SECURE=false
SESSION_TTL=12h
REMEMBER_TTL=720h

TOKEN_LENGTH=16
MAX_ALERT_EMAILS=5
MIN_INTERVAL_MINUTES=5
REMINDER_INTERVAL=24h
EVALUATION_INTERVAL=1m
PING_RETENTION=0

# Optional: POST here after every evaluation to chain two instances.
STILLALIVE_POST_PING_URL=

# Only enable behind a proxy you control.
TRUST_PROXY=false

# Leave SMTP_HOST empty to write mails to the log instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=stillalive@localhost
MAIL_FROM_NAME="Still Alive"

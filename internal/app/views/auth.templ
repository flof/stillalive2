package views

templ LoginPage(p Page, values LoginValues, errors FormErrors) {
	@Layout(p) {
		<section class="card auth-card">
			<h1>Log in</h1>
			<form method="post" action="/login" class="form">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label class="field">
					<span>Email address</span>
					<input type="email" name="email" value={ values.Email } autocomplete="email" required autofocus/>
					@FieldError(errors, "email")
				</label>
				<label class="field">
					<span>Password</span>
					<input type="password" name="password" autocomplete="current-password" required/>
					@FieldError(errors, "password")
				</label>
				<label class="checkbox">
					<input type="checkbox" name="remember" value="1"/>
					<span>Remember me for 30 days</span>
				</label>
				<div class="form-actions">
					<button class="btn" type="submit">Log in</button>
					<a class="text-link" href="/password/forgot">Forgot your password?</a>
				</div>
			</form>
			<p class="muted">No account yet? <a href="/register">Register</a></p>
		</section>
	}
}

templ RegisterPage(p Page, values RegisterValues, errors FormErrors, timezones []string) {
	@Layout(p) {
		<section class="card auth-card">
			<h1>Register</h1>
			<form method="post" action="/register" class="form">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label class="field">
					<span>Name</span>
					<input type="text" name="name" value={ values.Name } autocomplete="name" required autofocus/>
					@FieldError(errors, "name")
				</label>
				<label class="field">
					<span>Email address</span>
					<input type="email" name="email" value={ values.Email } autocomplete="email" required/>
					@FieldError(errors, "email")
				</label>
				<div class="grid-2">
					<label class="field">
						<span>Password</span>
						<input type="password" name="password" autocomplete="new-password" required minlength="6"/>
						@FieldError(errors, "password")
					</label>
					<label class="field">
						<span>Confirm password</span>
						<input type="password" name="password_confirmation" autocomplete="new-password" required minlength="6"/>
					</label>
				</div>
				<label class="field">
					<span>Timezone</span>
					<select name="timezone" required>
						for _, tz := range timezones {
							<option value={ tz } selected?={ tz == values.Timezone }>{ tz }</option>
						}
					</select>
					@FieldError(errors, "timezone")
				</label>
				<label class="checkbox">
					<input type="checkbox" name="terms" value="1" checked?={ values.Terms }/>
					<span>I agree with the <a href="/terms" target="_blank">terms of service</a></span>
					@FieldError(errors, "terms")
				</label>
				<div class="form-actions">
					<button class="btn" type="submit">Create account</button>
				</div>
			</form>
			<p class="muted">Already registered? <a href="/login">Log in</a></p>
		</section>
	}
}

templ ForgotPasswordPage(p Page, errors FormErrors) {
	@Layout(p) {
		<section class="card auth-card">
			<h1>Reset your password</h1>
			<p class="muted">Enter your email address and we will send you a reset link.</p>
			<form method="post" action="/password/forgot" class="form">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label class="field">
					<span>Email address</span>
					<input type="email" name="email" autocomplete="email" required autofocus/>
					@FieldError(errors, "email")
				</label>
				<div class="form-actions">
					<button class="btn" type="submit">Send reset link</button>
					<a class="text-link" href="/login">Back to login</a>
				</div>
			</form>
		</section>
	}
}

templ ResetPasswordPage(p Page, token, email string, errors FormErrors) {
	@Layout(p) {
		<section class="card auth-card">
			<h1>Choose a new password</h1>
			<form method="post" action={ "/password/reset/" + token } class="form">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<input type="hidden" name="email" value={ email }/>
				<label class="field">
					<span>New password</span>
					<input type="password" name="password" autocomplete="new-password" required minlength="8"/>
					@FieldError(errors, "password")
				</label>
				<label class="field">
					<span>Confirm new password</span>
					<input type="password" name="password_confirmation" autocomplete="new-password" required minlength="8"/>
				</label>
				@FieldError(errors, "token")
				<div class="form-actions">
					<button class="btn" type="submit">Save password</button>
				</div>
			</form>
		</section>
	}
}

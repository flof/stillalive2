package views

templ HomePage(p Page) {
	@Layout(p) {
		<section class="hero">
			<h1>Still Alive</h1>
			<p class="lead">
				A small heartbeat service for tasks on your servers that have no public interface.
			</p>
			if p.User == nil {
				<div class="hero-actions">
					<a class="btn" href="/login">Log in</a>
					<a class="btn btn-secondary" href="/register">Create an account</a>
				</div>
			} else {
				<div class="hero-actions">
					<a class="btn" href="/monitors">Open monitors</a>
				</div>
			}
		</section>

		<div class="cards">
			<section class="card">
				<h2>What is it for?</h2>
				<p>
					Still Alive watches the regular execution of tasks that have no public
					interface and therefore are not reachable from the internet: backup
					scripts, cleanup jobs, cronjobs of any kind.
				</p>
			</section>
			<section class="card">
				<h2>How does it work?</h2>
				<p>
					Unlike a typical website monitor, Still Alive does not probe your service.
					Your job sends a ping after each successful run. If no ping arrives within
					the configured interval, Still Alive assumes the job is down and emails you.
				</p>
			</section>
			<section class="card">
				<h2>Getting a ping in</h2>
				<p>
					Each monitor has a secret URL. One <code>curl -X POST</code> at the end of
					your script is enough. No agent, no credentials, no SDK.
				</p>
			</section>
		</div>
	}
}

templ ImprintPage(p Page) {
	@Layout(p) {
		<section class="card prose">
			<h1>Imprint</h1>
			<p><em>The following information is required by Austrian law.</em></p>
			<p>
				Offenlegung nach dem Mediengesetz 2005<br/>
				Inhalt und Gestaltung<br/>
				Florian Fankhauser<br/>
				6060 Hall
			</p>
		</section>
	}
}

